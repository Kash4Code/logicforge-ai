# 1. SECURITY & ACCESS CONTROL
# Set a custom access code for the web client (Passcode Gate)
CODE=your_custom_passcode_here

# 2. FREE CLOUD API PROVIDERS (Default System Pool)
# GroqCloud API Key (Ultra-fast inference tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google AI Studio API Key (Large context schema tier)
