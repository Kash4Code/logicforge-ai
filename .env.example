# OpenRouter API Key (Dynamic open-weight fallback tier)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# 3. CUSTOM SYSTEM PROMPT OVERRIDE (Socratic Mentor Engine)
# Embedded directly into client settings or environment overrides
DEFAULT_MODEL=llama-3.3-70b-versatile